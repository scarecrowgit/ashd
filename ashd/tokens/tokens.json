{
  "$meta": {
    "name": "ashd",
    "default": "ash",
    "version": "0.2",
    "notes": "Semantic tokens are identical across themes; only values change. Text contrast vs surface >= 4.5:1. shape.rail/dock/scratchpad/default-mode: docs/design/TOKENS.md section 6 (Theme structure)."
  },
  "shared": {
    "space": {
      "2": "2px",
      "4": "4px",
      "6": "6px",
      "8": "8px",
      "10": "10px",
      "12": "12px",
      "16": "16px",
      "24": "24px",
      "32": "32px"
    },
    "font-size": {
      "display": "28px",
      "title": "15px",
      "body": "13px",
      "ui": "12.5px",
      "label": "10.5px",
      "code": "12px",
      "numeric": "16px"
    },
    "font-weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "label": {
      "transform": "uppercase",
      "letter-spacing": "0.08em",
      "family": "mono"
    },
    "border": {
      "width": "1px"
    },
    "shadow": {
      "overlay": "0 24px 60px rgba(0,0,0,.45)",
      "quicklook": "0 30px 80px rgba(0,0,0,.55)",
      "flyout": "0 18px 40px rgba(0,0,0,.35)"
    },
    "scrim": {
      "modal": "rgba(0,0,0,.55)",
      "power": "rgba(0,0,0,.60)"
    },
    "duration": {
      "instant": "80ms",
      "fast": "120ms",
      "flyout": "160ms",
      "base": "220ms",
      "slow": "300ms"
    },
    "easing": {
      "standard": "cubic-bezier(.2,.8,.2,1)",
      "enter": "cubic-bezier(.16,1,.3,1)",
      "exit": "cubic-bezier(.5,1,.89,1)",
      "toast": "cubic-bezier(.33,1,.68,1)",
      "linear": "linear",
      "out-cubic": "cubic-bezier(.33,1,.68,1)"
    },
    "spring": {
      "view": {
        "damping": 1.0,
        "stiffness": 800
      },
      "pane-resize": {
        "damping": 1.0,
        "stiffness": 800
      },
      "workspace-switch": {
        "damping": 1.0,
        "stiffness": 1000
      },
      "canvas-zoom": {
        "damping": 1.0,
        "stiffness": 600
      },
      "canvas-pan": {
        "damping": 1.0,
        "stiffness": 500
      },
      "scratchpad": {
        "damping": 1.0,
        "stiffness": 700
      },
      "shake": {
        "damping": 0.4,
        "stiffness": 900
      }
    }
  },
  "themes": {
    "ash": {
      "color": {
        "bg": "#111110",
        "surface": "#161615",
        "surface-2": "#1B1B19",
        "line": "#2A2A27",
        "frame": "#2A2A27",
        "fg": "#DAD7CF",
        "fg-muted": "#96938B",
        "accent": "#E0A458",
        "on-accent": "#161615",
        "ok": "#9DBF86",
        "warn": "#E6C25A",
        "err": "#E07A62",
        "info": "#8DB0D6",
        "syn-keyword": "#E0A458",
        "syn-string": "#C2BEB4",
        "syn-number": "#DAD7CF",
        "syn-comment": "#8A877F"
      },
      "font": {
        "sans": "Inter",
        "mono": "JetBrains Mono"
      },
      "radius": {
        "panel": "0px",
        "window": "0px",
        "control": "0px"
      },
      "shape": {
        "layout": "attached",
        "gap": "0px",
        "rail": {
          "variant": "num",
          "width": "64px"
        },
        "dock": {
          "variant": "bar",
          "height": "46px"
        },
        "scratchpad": "stack",
        "default-mode": "scroll"
      }
    },
    "ink": {
      "color": {
        "bg": "#0E0F11",
        "surface": "#15171A",
        "surface-2": "#1A1D21",
        "line": "#2A2E34",
        "frame": "#4A4F57",
        "fg": "#E6E2D9",
        "fg-muted": "#9C998F",
        "accent": "#FF5B3A",
        "on-accent": "#0E0F11",
        "ok": "#8FC48C",
        "warn": "#E7C35E",
        "err": "#F2667A",
        "info": "#8DB4E2",
        "syn-keyword": "#FF6D4F",
        "syn-string": "#C9C5BC",
        "syn-number": "#E6E2D9",
        "syn-comment": "#8C8982"
      },
      "font": {
        "sans": "IBM Plex Sans",
        "mono": "IBM Plex Mono"
      },
      "radius": {
        "panel": "0px",
        "window": "0px",
        "control": "0px"
      },
      "shape": {
        "layout": "floating",
        "gap": "10px",
        "rail": {
          "variant": "thumb",
          "width": "92px"
        },
        "dock": {
          "variant": "split",
          "height": "52px"
        },
        "scratchpad": "tabs",
        "default-mode": "canvas"
      }
    },
    "midnight": {
      "color": {
        "bg": "#0B0D12",
        "surface": "#12151C",
        "surface-2": "#171B24",
        "line": "#252B38",
        "frame": "#252B38",
        "fg": "#E3E6EE",
        "fg-muted": "#9098A9",
        "accent": "#7088FF",
        "on-accent": "#0B0D12",
        "ok": "#8CCB9E",
        "warn": "#E7C46A",
        "err": "#F07A7A",
        "info": "#7FC6E8",
        "syn-keyword": "#8095FF",
        "syn-string": "#B7BDCB",
        "syn-number": "#E3E6EE",
        "syn-comment": "#7D8496"
      },
      "font": {
        "sans": "Inter Tight",
        "mono": "Geist Mono"
      },
      "radius": {
        "panel": "8px",
        "window": "6px",
        "control": "4px"
      },
      "shape": {
        "layout": "floating",
        "gap": "10px",
        "rail": {
          "variant": "pill",
          "width": "60px"
        },
        "dock": {
          "variant": "pill",
          "height": "54px"
        },
        "scratchpad": "stack",
        "default-mode": "scroll",
        "label-caps": false
      }
    },
    "moss": {
      "color": {
        "bg": "#0C0E0C",
        "surface": "#121512",
        "surface-2": "#171B17",
        "line": "#262C26",
        "frame": "#2E352E",
        "fg": "#DCE2D8",
        "fg-muted": "#8F998C",
        "accent": "#A6D1A4",
        "on-accent": "#0C0E0C",
        "ok": "#C2D98A",
        "warn": "#E3C266",
        "err": "#E0806A",
        "info": "#8EB8D2",
        "syn-keyword": "#A6D1A4",
        "syn-string": "#C3CABF",
        "syn-number": "#DCE2D8",
        "syn-comment": "#7E887B"
      },
      "font": {
        "sans": "Geist",
        "mono": "Geist Mono"
      },
      "radius": {
        "panel": "4px",
        "window": "3px",
        "control": "2px"
      },
      "shape": {
        "layout": "floating",
        "gap": "8px",
        "rail": {
          "variant": "num",
          "width": "64px"
        },
        "dock": {
          "variant": "split",
          "height": "52px"
        },
        "scratchpad": "tabs",
        "default-mode": "canvas"
      }
    },
    "dusk": {
      "color": {
        "bg": "#0F0D13",
        "surface": "#16131B",
        "surface-2": "#1C1822",
        "line": "#2C2734",
        "frame": "#2C2734",
        "fg": "#E7E2EE",
        "fg-muted": "#A098AB",
        "accent": "#B7A4FF",
        "on-accent": "#120F18",
        "ok": "#92CDA6",
        "warn": "#E9C878",
        "err": "#F08A9A",
        "info": "#8FB7F0",
        "syn-keyword": "#B7A4FF",
        "syn-string": "#CBC4D6",
        "syn-number": "#E7E2EE",
        "syn-comment": "#8A8296"
      },
      "font": {
        "sans": "Manrope",
        "mono": "JetBrains Mono"
      },
      "radius": {
        "panel": "12px",
        "window": "8px",
        "control": "6px"
      },
      "shape": {
        "layout": "floating",
        "gap": "12px",
        "rail": {
          "variant": "thumb",
          "width": "92px"
        },
        "dock": {
          "variant": "pill",
          "height": "54px"
        },
        "scratchpad": "stack",
        "default-mode": "scroll",
        "label-caps": false
      }
    }
  }
}
