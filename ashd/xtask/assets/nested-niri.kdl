// niri config for the headless nested test session (`cargo xtask nested`).
// Ash-like layout so screenshots resemble the real desktop; no spawn-at-startup.
input {
    keyboard {
        xkb {
            layout "us,ru"
        }
    }
}

layout {
    gaps 12
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    background-color "#111110"
    focus-ring {
        width 1
        active-color "#E0A458"
        inactive-color "#2A2A27"
    }
    border {
        off
    }
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

animations {
    off
}

// The test driver parks the pointer at (0,0): no overview hot corner.
gestures {
    hot-corners {
        off
    }
}

screenshot-path null
