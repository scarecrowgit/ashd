{ hostVars, ... }:

# Hermes Agent gateway runtime fixes for NixOS.
# The gateway's user unit (~/.config/systemd/user/hermes-gateway.service) is generated by Hermes
# itself and rewritten on every `hermes gateway restart`, so fixes live in a drop-in, which it never touches.
{
  # Gateway is a systemd *user* service: keep it (and its kanban/cron workers) alive without a login.
  users.users.${hostVars.userName}.linger = true;

  home-manager.sharedModules = [
    ({ config, ... }:
      let
        home = config.home.homeDirectory;
      in
      {
        # Hermes-generated unit only puts FHS dirs on PATH. On NixOS that hides systemd-run
        # (kanban/cron workers are spawned via `systemd-run --user --scope`), git, node, etc.
        xdg.configFile."systemd/user/hermes-gateway.service.d/nixos-path.conf" = {
          force = true; # replace the hand-written copy made before this module existed
          text = ''
            [Service]
            Environment="PATH=${home}/.hermes/hermes-agent/node_modules/.bin:${home}/.hermes/tools/node-26.7.0-linux-x64/bin:${home}/.hermes/tools/npm-12.0.2-linux-x64/bin:${home}/.local/bin:${home}/.npm-global/bin:/run/wrappers/bin:${home}/.nix-profile/bin:/etc/profiles/per-user/${hostVars.userName}/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin"
            # The gateway runs through an `-I -c` launcher that patches sys.path in-process only, so
            # workers spawned as `python -m hermes_cli.main` can't import hermes. Use the launcher instead.
            Environment="HERMES_BIN=${home}/.hermes/hermes-agent/.hermes/bin/hermes"
          '';
        };
      })
  ];
}
