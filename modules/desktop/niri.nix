# niri fork + the generated system config.
#
# niri reads $XDG_CONFIG_HOME/niri/config.kdl before /etc/niri/config.kdl, and this
# user still has a mutable ~/.config/niri from the old shell that would shadow ours.
# The niri.service drop-in below sets NIRI_CONFIG so the session always loads the
# generated file; the user's files are left untouched. (niri unsets NIRI_CONFIG for
# the programs it spawns.)
{ config, lib, pkgs, ... }:

let
  cfg = config.ashd;
  binds = import ./niri/binds.nix { inherit lib cfg; };

  configText = lib.concatStringsSep "\n" [
    "// Generated by NixOS (modules/desktop/niri.nix). Do not edit; change the Nix data."
    (import ./niri/layout.nix { inherit lib cfg; })
    (import ./niri/animations.nix { inherit lib cfg; })
    (import ./niri/workspaces.nix { inherit lib cfg; })
    (import ./niri/input.nix { inherit lib cfg; })
    (import ./niri/rules.nix { inherit lib cfg; })
    binds.kdl
    ''
      hotkey-overlay { skip-at-startup; }

      // `ashd theme apply` writes this; until it exists the Ash values above apply.
      // `~` expands since niri 26.04. optional=true only silences a missing file.
      include optional=true "~/.local/state/ashd/generated/niri.kdl"
    ''
  ];
in
{
  config = lib.mkIf cfg.enable {
    programs.niri = {
      enable = true;
      package = cfg.niriPackage;
    };

    environment.systemPackages = [
      pkgs.xwayland-satellite # niri starts it on demand when it is on PATH
      pkgs.wl-clipboard # clipboard panel, screenshots to clipboard, `wl-copy` in scripts
      pkgs.wf-recorder # `ashd record` / the screenshot overlay's "Record" mode
      pkgs.libnotify # notify-send, used by the shell's helpers and by scripts
      pkgs.xdg-utils # xdg-open: links and files opened from the launcher and panels
    ];

    # `ashd launcher` file search (`/`) uses plocate when it is on PATH and has a database;
    # services.locate installs the setgid wrapper and updates the database daily.
    services.locate = {
      enable = true;
      package = pkgs.plocate;
    };

    assertions = [{
      assertion = binds.duplicates == [ ];
      message = "ashd: key combinations bound more than once in modules/desktop/niri/binds.nix: ${lib.concatStringsSep ", " binds.duplicates}";
    }];

    environment.etc."niri/config.kdl".text = configText;

    systemd.user.services.niri.environment.NIRI_CONFIG = "/etc/niri/config.kdl";
  };
}
