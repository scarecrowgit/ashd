# Login: greetd running either the graphical ashd-greeter (default) or tuigreet.
#
# ashd-greeter is a Wayland client (one fullscreen layer-shell surface per output), so
# greetd has to run it inside a compositor. Two candidates were weighed:
#
#   cage -s -- ashd-greeter     tiny, but it has no output configuration at all (no mode,
#                               no scale; `-s` only allows VT switching) and takes its
#                               keyboard layout from XKB_DEFAULT_* env vars, and it has no
#                               wlr-layer-shell, so the greeter would fall back to a
#                               fullscreen xdg-toplevel.
#   niri -c greeter-niri.kdl    the same compositor the session runs: the output modes,
#                               scales and cursor come from the very same ashd.outputs /
#                               ashd.cursor options (niri/input.nix is reused verbatim),
#                               the keyboard layout from ashd.input.xkb, and it has
#                               wlr-layer-shell, fractional-scale, viewporter and
#                               cursor-shape, i.e. everything ashd-gfx uses.
#
# niri is therefore used (no extra package either). Its config has no binds, no
# animations and a black background; the only thing it does is start the greeter and
# quit once the greeter exits, which is what lets greetd go on to start the session
# (greetd waits for the greeter command, here niri, to terminate).
#
# `ashd.greeter.kind = "tuigreet"` is the fallback to the old text greeter.
{ config, lib, pkgs, ... }:

let
  cfg = config.ashd;
  gcfg = cfg.greeter;
  inherit (lib) mkOption types;

  greeterBin = "${cfg.package}/bin/ashd-greeter";
  niriBin = "${cfg.niriPackage}/bin/niri";

  greeterJson = builtins.toJSON {
    sessions = map (s: { inherit (s) name; cmd = s.command; }) gcfg.sessions;
    default_user = gcfg.defaultUser;
  };

  # Input, output and cursor settings exactly as in the session's niri config. The
  # rest of that config (binds, rules, layout, the generated theme include) is not used.
  greeterNiriConfig = lib.concatStringsSep "\n" [
    "// Generated by NixOS (modules/desktop/session.nix): the compositor that hosts ashd-greeter."
    (import ./niri/input.nix { inherit lib cfg; })
    ''
      prefer-no-csd

      layout {
          gaps 0
          background-color "#000000"
          focus-ring { off; }
          border { off; }
      }

      animations { off; }
      hotkey-overlay { skip-at-startup; }

      // No binds on purpose: nothing but the greeter is reachable.
      binds { }

      // greetd waits for this compositor to exit before it starts the user's session, so
      // quit it whenever the greeter ends (success: exit 0 after start_session; failure:
      // greetd then restarts the whole thing).
      spawn-sh-at-startup "${pkgs.systemd}/bin/systemd-cat -t ashd-greeter ${greeterBin}; ${niriBin} msg action quit --skip-confirmation"
    ''
  ];
in
{
  options.ashd.greeter = {
    kind = mkOption {
      type = types.enum [ "ashd" "tuigreet" ];
      default = "tuigreet";
      description = ''
        The login screen. "tuigreet" is the text greeter and the default. "ashd" is
        the graphical ashd-greeter inside a minimal niri: it has been exercised in demo
        mode on a real GPU and, under real greetd in the VM test, it starts, finds
        Vulkan and connects to its compositor, but the VM cannot show it (niri has no
        output there), so it has never been seen working end to end. Opt in after the
        first successful login; `journalctl -t ashd-greeter` shows what it did, and if
        it fails you can still log in on another console (Ctrl+Alt+F2).
      '';
    };

    sessions = mkOption {
      type = types.listOf (types.submodule {
        options = {
          name = mkOption {
            type = types.str;
            example = "niri";
            description = "Name shown on the session line of the greeter.";
          };
          command = mkOption {
            type = types.listOf types.str;
            example = [ "niri-session" ];
            description = "Argument vector handed to greetd's start_session.";
          };
        };
      });
      default = [{ name = "niri"; command = [ "niri-session" ]; }];
      description = ''
        Sessions the graphical greeter can start; the first is the default, more than one
        makes the session line selectable (Up / Down). Written to /etc/ashd/greeter.json.
        tuigreet always starts niri-session.
      '';
    };

    defaultUser = mkOption {
      type = types.nullOr types.str;
      default = null;
      example = "alice";
      description = ''
        User name pre-filled on the very first boot (afterwards the last successful user,
        remembered in /var/cache/ashd-greeter/state.json, wins).
      '';
    };
  };

  config = lib.mkIf cfg.enable (lib.mkMerge [
    {
      assertions = [{
        assertion = gcfg.sessions != [ ];
        message = "ashd.greeter.sessions must not be empty.";
      }];
    }

    (lib.mkIf (gcfg.kind == "ashd") {
      services.greetd = {
        enable = true;
        settings.default_session = {
          command = "${niriBin} -c /etc/ashd/greeter-niri.kdl";
          user = "greeter";
        };
      };

      environment.etc."ashd/greeter-niri.kdl".text = greeterNiriConfig;
      environment.etc."ashd/greeter.json".text = greeterJson;

      # Last successful user + session. tmpfiles (not the greeter) creates the directory:
      # the greeter runs unprivileged as `greeter` and only writes the file.
      systemd.tmpfiles.rules = [ "d /var/cache/ashd-greeter 0755 greeter greeter - -" ];

      # The greeter's compositor reads the cursor theme through XCURSOR_PATH, and the
      # greeter user has no profile that would add the system share dir.
      systemd.services.greetd.environment.XCURSOR_PATH = "/run/current-system/sw/share/icons";
    })

    (lib.mkIf (gcfg.kind == "tuigreet") {
      services.greetd = {
        enable = true;
        # tuigreet prints to the tty: nixpkgs keeps boot messages off it with this.
        useTextGreeter = true;
        settings.default_session = {
          command = "${pkgs.tuigreet}/bin/tuigreet --time --remember --remember-session --cmd niri-session";
          user = "greeter";
        };
      };
    })

    # Sleep targets and HandlePowerKey=poweroff stay host-level (hosts/<name>/default.nix).
  ]);
}
